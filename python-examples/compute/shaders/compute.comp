#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D samp;

layout(set = 0, binding = 1, std140) uniform SpriteExtended {
    vec4 mouse;
    vec4 u0;
    vec4 u1;
    vec4 u2;
    vec4 u3;
    vec4 custom_uniforms[16];
    vec4 audio_bands;
    vec4 audio_history;
} ext;

layout(set = 0, binding = 5, rgba8) writeonly uniform image2D outputImage;

#define iMouse ext.mouse

#define alpha ext.u0.x
#define iTime ext.u0.y
#define iResolution ext.u0.zw

#define iTimeDelta ext.u1.x
#define amp ext.u1.y
#define iamp ext.u1.z
#define iFrameRate ext.u1.w

#define iFrame int(ext.u2.x)
#define time_f ext.u2.y
#define iSampleRate ext.u2.z
#define amp_peak ext.u2.w

#define history_head int(ext.u3.x)
#define history_size int(ext.u3.y)
#define amp_rms ext.u3.z
#define amp_smooth ext.u3.w

#define amp_low ext.audio_bands.x
#define amp_mid ext.audio_bands.y
#define amp_high ext.audio_bands.z

#define effect_strength ext.custom_uniforms[0].x
#define wave_amount ext.custom_uniforms[0].y
#define color_shift ext.custom_uniforms[0].z
#define mouse_strength ext.custom_uniforms[0].w

vec2 clampUV(vec2 uv) {
    return clamp(uv, vec2(0.0), vec2(1.0));
}

vec3 sampleChromatic(vec2 uv, float amount) {
    vec2 direction = vec2(amount, 0.0);

    float red = texture(samp, clampUV(uv + direction)).r;
    float green = texture(samp, clampUV(uv)).g;
    float blue = texture(samp, clampUV(uv - direction)).b;

    return vec3(red, green, blue);
}

void main() {
    ivec2 position = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);

    if(any(greaterThanEqual(position, size))) {
        return;
    }

    vec2 resolution = max(iResolution, vec2(1.0));
    vec2 uv = (vec2(position) + 0.5) / vec2(size);

    float time = time_f;

    float waveX = sin(uv.y * 28.0 + time * 2.2 + float(iFrame) * 0.002);
    float waveY = cos(uv.x * 21.0 - time * 1.7);

    vec2 distortedUV = uv;

    distortedUV.x += waveX * wave_amount * effect_strength;
    distortedUV.y += waveY * wave_amount * 0.35 * effect_strength;

    vec2 mouseUV = iMouse.xy / resolution;

    if(iMouse.z > 0.5) {
        vec2 delta = distortedUV - mouseUV;
        float distanceToMouse = length(delta);
        float lens = exp(-distanceToMouse * distanceToMouse * 42.0);
        vec2 direction = normalize(delta + vec2(0.000001));

        distortedUV -= direction * lens * mouse_strength;
    }

    distortedUV = clampUV(distortedUV);

    float chromaticAmount = 0.0025 + color_shift * 0.004 + amp_high * 0.01;

    vec3 color = sampleChromatic(distortedUV, chromaticAmount);

    float audioEnergy = amp * 0.30 + amp_rms * 0.25 + amp_smooth * 0.25 + amp_peak * 0.20;

    color.r *= 1.0 + amp_low * 0.35;
    color.g *= 1.0 + amp_mid * 0.20;
    color.b *= 1.0 + amp_high * 0.30;

    float pulse = 0.92 + 0.08 * sin(time * 2.0 + audioEnergy * 5.0);

    color *= pulse;

    float animatedAlpha = clamp(alpha / 6.0, 0.0, 1.0);

    color *= mix(0.92, 1.12, animatedAlpha);

    float mouseGlow = 0.0;

    if(iMouse.z > 0.5) {
        float distanceToMouse = distance(uv, mouseUV);
        mouseGlow = exp(-distanceToMouse * distanceToMouse * 85.0);
    }

    color += vec3(0.10, 0.35, 1.0) * mouseGlow * 0.35;

    color = clamp(color, vec3(0.0), vec3(1.0));

    imageStore(outputImage, position, vec4(color, 1.0));
}
